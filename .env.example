# Safe local defaults. Never place real credentials in this file.
REDTEAM_BIND_HOST=127.0.0.1
REDTEAM_API_PORT=18150
REDTEAM_REPORT_ROOT=reports/runs
REDTEAM_INVENTORY_CACHE=reports/cache/inventory.json
REDTEAM_ALLOWED_CIDRS=127.0.0.0/8,::1/128
REDTEAM_ALLOWED_DOMAINS=
REDTEAM_ALLOWED_KALI_ALIASES=
REDTEAM_ALLOW_PUBLIC=false
REDTEAM_API_TOKEN=replace-with-a-long-random-local-token
REDTEAM_RATE_LIMIT_PER_MINUTE=30
REDTEAM_MAX_CONCURRENCY=4
REDTEAM_REQUEST_BODY_LIMIT=32768
REDTEAM_REQUEST_TIMEOUT_SECONDS=60
REDTEAM_RETENTION_DAYS=30
REDTEAM_CONFIGURED_AGENT_ENDPOINTS=http://127.0.0.1:18080
REDTEAM_OLLAMA_ENDPOINTS=http://127.0.0.1:11434
REDTEAM_OLLAMA_DISCOVERY_TIMEOUT=1.5
REDTEAM_OLLAMA_LIVE_CHECK=false
REDTEAM_METADATA_RESPONSE_SIZE=2000000
REDTEAM_LISTENER_DISCOVERY_METHOD=auto
REDTEAM_LISTENER_CACHE_TTL_SECONDS=30
REDTEAM_INCLUDE_UDP=false
REDTEAM_INCLUDE_DOCKER=false
REDTEAM_INCLUDE_STOPPED_CONTAINERS=false
REDTEAM_DOCKER_TIMEOUT=5
REDTEAM_INCLUDE_KALI_READINESS=false
REDTEAM_KALI_LIVE_CHECK=false
REDTEAM_KALI_READINESS_TIMEOUT=8
REDTEAM_HTTP_METADATA_ROUTES=/health,/metadata,/targets,/openapi.json,/v1/models
REDTEAM_KNOWN_LOCAL_SERVICE_PORTS=18080,18101,18102,8000,8080,5000,5001
REDTEAM_INVENTORY_CACHE_TTL_SECONDS=60
REDTEAM_PASSIVE_ONLY=true
REDTEAM_DEFAULT_OLLAMA_MODEL=llama3.2:1b
REDTEAM_APPROVED_HOST_PORTS=22,80,443,8000,8080,8443,11434
REDTEAM_HOST_TIMEOUT_SECONDS=3
REDTEAM_WEB_PATH_ALLOWLIST=/,/health,/metadata,/openapi.json
REDTEAM_MAXIMUM_REDIRECTS=3
REDTEAM_MAXIMUM_RESPONSE_BYTES=262144
REDTEAM_ASSESSMENT_MAXIMUM_REQUESTS=40
REDTEAM_ASSESSMENT_MAXIMUM_DURATION_SECONDS=300
REDTEAM_ASSESSMENT_MAXIMUM_CONCURRENCY=1
REDTEAM_TLS_VERIFY=true
REDTEAM_TLS_MINIMUM_VERSION=TLSv1.2
REDTEAM_KALI_TOOL_ALLOWLIST=nmap,whatweb,curl
REDTEAM_NUCLEI_SAFE_TEMPLATE_ALLOWLIST=
REDTEAM_ADAPTIVE_DEFAULT_MODE=off
REDTEAM_ADAPTIVE_CATEGORIES=prompt_disclosure,prompt_injection,synthetic_secret,weak_refusal,unsafe_tool_claim,output_schema,error_leakage,model_metadata
REDTEAM_ADAPTIVE_MAX_ROUNDS=8
REDTEAM_ADAPTIVE_MAX_TOTAL_PROBES=100
REDTEAM_ADAPTIVE_MAX_PROBES_PER_ROUND=15
REDTEAM_ADAPTIVE_MAX_MODEL_CALLS=25
REDTEAM_ADAPTIVE_MAX_DURATION_SECONDS=1200
REDTEAM_ADAPTIVE_NO_NOVELTY_ROUNDS=2
REDTEAM_ADAPTIVE_DUPLICATE_RATE_THRESHOLD=0.5
REDTEAM_ADAPTIVE_PROMPT_MAX_CHARACTERS=4000
REDTEAM_ADAPTIVE_PROVIDER_TIMEOUT_SECONDS=30
REDTEAM_ADAPTIVE_PROVIDER_RETRIES=1
REDTEAM_ADAPTIVE_PROVIDER_REPAIRS=1
REDTEAM_ADAPTIVE_DETERMINISTIC_FALLBACK=true
REDTEAM_ADAPTIVE_BENCHMARK_ROOT=reports/benchmarks
REDTEAM_ADAPTIVE_BENCHMARK_DATASET=phase6-v1
DEXTER_NAME=Dexter
DEXTER_API_ENDPOINT=http://127.0.0.1:8000
DEXTER_HEALTH_PATH=/status
DEXTER_CHAT_PATH=/chat
DEXTER_METADATA_PATH=/metadata
DEXTER_OPENAPI_PATH=/openapi.json
DEXTER_AUTHENTICATION_MODE=none
DEXTER_AUTHENTICATION_REFERENCE=local-keychain-entry-name
DEXTER_OLLAMA_ENDPOINT=http://127.0.0.1:11434
DEXTER_EXPECTED_MODEL=llama3.2:1b
DEXTER_TOOL_ENDPOINTS=http://127.0.0.1:8000/tools
DEXTER_MEMORY_ENDPOINT=http://127.0.0.1:8000/memory
DEXTER_VECTOR_ENDPOINT=http://127.0.0.1:6333
DEXTER_RETRIEVAL_ENDPOINT=http://127.0.0.1:8000/retrieval
DEXTER_VOICE_ENDPOINTS=
DEXTER_DOCKER_NAMES=dexter-local
DEXTER_DOCKER_LABELS=app=dexter
DEXTER_EXPECTED_PORTS=8000
DEXTER_ALLOWED_PROFILES=passive,standard,deep-lab
DEXTER_DISPOSABLE_MEMORY_NAMESPACE=false
DEXTER_REQUIRES_KALI_TUNNEL=true
DEXTER_KALI_REMOTE_PORT=18000
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
OPENWEATHER_API_KEY=replace-with-provider-key-if-used
KALI_SSH_HOST=kali-lab
KALI_SSH_KEY=/path/to/authorized-lab-key
