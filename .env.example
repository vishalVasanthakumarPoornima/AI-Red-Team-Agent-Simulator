# Safe local defaults. Never place real credentials in this file.
REDTEAM_BIND_HOST=127.0.0.1
REDTEAM_API_PORT=18150
REDTEAM_REPORT_ROOT=reports/runs
REDTEAM_INVENTORY_CACHE=reports/cache/inventory.json
REDTEAM_ALLOWED_CIDRS=127.0.0.0/8,::1/128
REDTEAM_ALLOWED_DOMAINS=
REDTEAM_ALLOWED_KALI_ALIASES=
REDTEAM_ALLOW_PUBLIC=false
REDTEAM_API_TOKEN=replace-with-a-long-random-local-token
REDTEAM_RATE_LIMIT_PER_MINUTE=30
REDTEAM_MAX_CONCURRENCY=4
REDTEAM_REQUEST_BODY_LIMIT=32768
REDTEAM_REQUEST_TIMEOUT_SECONDS=60
REDTEAM_RETENTION_DAYS=30
REDTEAM_CONFIGURED_AGENT_ENDPOINTS=http://127.0.0.1:18080
REDTEAM_OLLAMA_ENDPOINTS=http://127.0.0.1:11434
REDTEAM_OLLAMA_DISCOVERY_TIMEOUT=1.5
REDTEAM_OLLAMA_LIVE_CHECK=false
REDTEAM_METADATA_RESPONSE_SIZE=2000000
REDTEAM_LISTENER_DISCOVERY_METHOD=auto
REDTEAM_LISTENER_CACHE_TTL_SECONDS=30
REDTEAM_INCLUDE_UDP=false
REDTEAM_INCLUDE_DOCKER=false
REDTEAM_INCLUDE_STOPPED_CONTAINERS=false
REDTEAM_DOCKER_TIMEOUT=5
REDTEAM_INCLUDE_KALI_READINESS=false
REDTEAM_KALI_LIVE_CHECK=false
REDTEAM_KALI_READINESS_TIMEOUT=8
REDTEAM_HTTP_METADATA_ROUTES=/health,/metadata,/targets,/openapi.json,/v1/models
REDTEAM_KNOWN_LOCAL_SERVICE_PORTS=18080,18101,18102,8000,8080,5000,5001
REDTEAM_INVENTORY_CACHE_TTL_SECONDS=60
REDTEAM_PASSIVE_ONLY=true
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
OPENWEATHER_API_KEY=replace-with-provider-key-if-used
KALI_SSH_HOST=kali-lab
KALI_SSH_KEY=/path/to/authorized-lab-key
